rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // إتاحة قراءة إعدادات ومعلومات المتجر العامة (الاسم والشعار) للجميع لعرضها في بوابة العملاء وإيصالات الفواتير
    match /settings/store_info {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // جميع المجموعات والبيانات الأخرى تتطلب تسجيل الدخول
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
