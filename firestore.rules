rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // إتاحة قراءة إعدادات ومعلومات المتجر العامة للجميع
    match /settings/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // إتاحة قراءة المنتجات للـ POS وعروض الأسعار والكتالوج
    match /products/{product=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // عروض الأسعار
    match /offers/{offer=**} {
      allow read, write: if true;
    }

    // دليل العملاء
    match /customers/{customer=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // جميع المجموعات والعمليات الحساسة الأخرى تتطلب تسجيل الدخول
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
